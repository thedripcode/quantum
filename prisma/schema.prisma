// Prisma schema for Sidelile High School
// Database: Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── NextAuth v5 required tables ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Admissions ───────────────────────────────────────────────────────────────

model Application {
  id               String   @id @default(cuid())
  ref              String   @unique              // e.g. SHS-2026-001
  firstName        String
  lastName         String
  dob              String?
  gender           String?
  idNumber         String?
  email            String?
  phone            String?
  address          String?
  city             String?
  province         String?
  parentName       String?
  parentRelation   String?
  parentPhone      String?
  parentEmail      String?
  parentOccupation String?
  previousSchool   String?
  previousGrade    String?
  previousYear     String?
  applyingGrade    String
  academicYear     String
  status           String   @default("Pending")  // Pending | Approved | Rejected | Waitlisted
  adminNote        String?
  documents        Json?                         // { label: string, url: string, name: string }[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Core User model ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?           // bcrypt hash — null for OAuth-only users
  role          String    @default("student")  // student | teacher | parent | admin
  portalId      String?   @unique              // e.g. STU2024001 or TCH001
  schoolEmail   String?   @unique              // e.g. STU2024001@sidelile.edu.za
  grade         String?                        // Grade 10 / 11 / 12 (students only)
  stream        String?                        // A / B / C / D — class section within a grade
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Parent ↔ student link (parent account stores the child's userId)
  linkedStudentId  String?

  // Password reset
  resetToken       String?
  resetTokenExpiry DateTime?

  accounts Account[]
  sessions Session[]

  taughtSubjects    Subject[]              @relation("SubjectTeacher")
  enrollments       Enrollment[]
  marks             Mark[]
  attendanceRecords AttendanceRecord[]
  submissions       AssignmentSubmission[]
  videosAdded       VideoResource[]        @relation("VideoAddedBy")
}

// ─── Academics ────────────────────────────────────────────────────────────────

model Subject {
  id        String  @id @default(cuid())
  code      String  @unique               // e.g. 'math'
  name      String                        // e.g. 'Mathematics'
  short     String                        // e.g. 'MATH'
  color     String  @default("#3B82F6")
  room      String?
  grades    String  @default("")          // comma-separated grades: "Grade 10,Grade 11,Grade 12"
  teacherId String?
  teacher   User?   @relation("SubjectTeacher", fields: [teacherId], references: [id])

  enrollments Enrollment[]
  marks       Mark[]
  assignments Assignment[]
  timetable   TimetableSlot[]
  exams       Exam[]
  videos      VideoResource[]
}

// Teacher-curated video lessons (YouTube etc.) shown in the student portal
model VideoResource {
  id          String   @id @default(cuid())
  title       String
  url         String                        // original link as pasted
  videoId     String?                       // YouTube video id (embeds + thumbnails)
  provider    String   @default("youtube")  // youtube | vimeo | other
  description String?
  grade       String?                       // e.g. 'Grade 11' — null = all grades
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  addedById   String
  addedBy     User     @relation("VideoAddedBy", fields: [addedById], references: [id])
  createdAt   DateTime @default(now())
}

model Enrollment {
  id         String @id @default(cuid())
  studentId  String
  subjectId  String
  targetMark Int    @default(75)

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
}

model Mark {
  id        String   @id @default(cuid())
  studentId String
  subjectId String
  task      String                        // e.g. 'Test 1'
  type      String   @default("Test")     // Test | Assignment | Exam | Project
  score     Float
  total     Float
  weight    Int      @default(0)
  term      Int      @default(1)
  date      DateTime @default(now())

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime
  status    String                        // present | absent | late | excused
  note      String?

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

model Assignment {
  id          String   @id @default(cuid())
  subjectId   String
  title       String
  description String?
  type        String   @default("Assignment") // Assignment | Project | Essay | Practical
  dueDate     DateTime
  total       Int      @default(100)
  priority    String   @default("medium")     // high | medium | low

  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id            String    @id @default(cuid())
  assignmentId  String
  studentId     String
  submittedDate DateTime?
  mark          Float?
  feedback      String?
  status        String    @default("pending") // pending | submitted | graded | overdue

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String   @default("Admin")     // Academic | Sport | Event | Admin | Urgent
  author    String?
  pinned    Boolean  @default(false)
  audience  String   @default("all")       // all | students | teachers | parents
  createdAt DateTime @default(now())
}

model TimetableSlot {
  id        String  @id @default(cuid())
  grade     String                          // e.g. 'Grade 11'
  day       String                          // Monday..Friday
  period    Int
  time      String                          // '07:30'
  endTime   String                          // '08:30'
  room      String?
  subjectId String

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

// ─── Messaging ────────────────────────────────────────────────────────────────

model Message {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  subject    String
  body       String
  readAt     DateTime?
  sentAt     DateTime  @default(now())
}

// ─── Student Goals ────────────────────────────────────────────────────────────

model Goal {
  id         String  @id @default(cuid())
  studentId  String
  subjectId  String
  targetMark Int     @default(75)
  note       String?

  @@unique([studentId, subjectId])
}

// ─── Exams ────────────────────────────────────────────────────────────────────

model Exam {
  id         String   @id @default(cuid())
  subjectId  String
  grade      String                        // e.g. 'Grade 11'
  term       Int      @default(1)
  year       Int
  date       DateTime
  startTime  String                        // '09:00'
  endTime    String                        // '11:00'
  venue      String?
  totalMarks Int      @default(100)
  notes      String?
  createdAt  DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

// ─── Past Papers ──────────────────────────────────────────────────────────────

model PastPaper {
  id          String   @id @default(cuid())
  subject     String
  subjectCode String   @default("")
  grade       String
  year        Int
  month       String
  type        String   @default("Exam")
  language    String   @default("English")
  fileName    String
  fileUrl     String
  fileSize    Int?
  uploadedAt  DateTime @default(now())
}
